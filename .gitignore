##############################################################################
# SENSITIVE / RESTRICTED DATA — never track, even accidentally
##############################################################################
resources/spreadsheets/*.xlsx
!resources/spreadsheets/README.md

resources/hg38.fa*
resources/hg38_genes.gtf
resources/mini_ar_test/_public_build_cache/
